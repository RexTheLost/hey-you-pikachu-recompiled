// Report inbox and update server for the Android port (crash reports in; latest build out).
// Deploy from this folder: npx wrangler deploy. Secret: ADMIN_KEY (HYP_REPORT_KEY in D:\AI\.env).
{
	"name": "hyp-reports",
	"main": "src/index.js",
	"compatibility_date": "2026-04-07",
	"workers_dev": true,
	"preview_urls": false,
	"kv_namespaces": [{ "binding": "BUILDS", "id": "fbacea70479340a5884152b9b3a392ca" }],
	"durable_objects": {
		"bindings": [{ "name": "REPORTS", "class_name": "Reports" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reports"] }]
}
