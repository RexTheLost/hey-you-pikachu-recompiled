diff --git a/src/gbi/rt64_gbi_f3dex2.cpp b/src/gbi/rt64_gbi_f3dex2.cpp
index 9f3a12c..47d9208 100644
--- a/src/gbi/rt64_gbi_f3dex2.cpp
+++ b/src/gbi/rt64_gbi_f3dex2.cpp
@@ -79,7 +79,20 @@ namespace RT64 {
                 state->rsp->setSegment((*dl)->p0(2, 4), (*dl)->w1);
                 break;
             case G_MW_FOG:
-                state->rsp->setFog((int16_t)((*dl)->p1(16, 16)), (int16_t)((*dl)->p1(0, 16)));
+                // Only offset 0 is the fog factor. F3DAM (Hey You, Pikachu!) keeps the texture T
+                // scale at G_MW_FOG + 0x10: its gSPTexture emits G_TEXTURE with S only (T = 0)
+                // followed by a moveword writing T there. Treating that write as fog fogged every
+                // model to the fog color, and ignoring it left T = 0 (textures smeared in one axis).
+                if ((*dl)->p0(0, 16) == 0) {
+                    state->rsp->setFog((int16_t)((*dl)->p1(16, 16)), (int16_t)((*dl)->p1(0, 16)));
+                }
+                else if ((*dl)->p0(0, 16) == 0x10) {
+                    // F3DAM texture scales are s.15 (0x7FFF ~ 1.0), not F3DEX2's 0.16 (0xFFFF ~ 1.0).
+                    // This write always directly follows the G_TEXTURE that set S, so convert both here.
+                    auto &textureState = state->rsp->textureState;
+                    textureState.sc = (uint16_t)std::min<uint32_t>(uint32_t(textureState.sc) << 1, 0xFFFF);
+                    textureState.tc = (uint16_t)std::min<uint32_t>(uint32_t((*dl)->p1(0, 16)) << 1, 0xFFFF);
+                }
                 break;
             case G_MW_LIGHTCOL:
                 state->rsp->setLightColor(((*dl)->p0(0, 16) / 24), (*dl)->w1);
