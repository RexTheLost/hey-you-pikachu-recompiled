new file mode 100644
index 0000000..d3eb88a
--- /dev/null
+++ b/src/shaders/PackedLoads.hlsli
@@ -0,0 +1,54 @@
+//
+// RT64
+//
+
+// Element reads from raw (byte address) buffers holding tightly packed little-endian data.
+// Used instead of typed buffers, whose size limit (maxTexelBufferElements) is tiny on some GPUs.
+
+uint loadU8(ByteAddressBuffer b, uint i) {
+    return (b.Load(i & ~3u) >> ((i & 3u) * 8u)) & 0xFFu;
+}
+
+int loadS8(ByteAddressBuffer b, uint i) {
+    return int(loadU8(b, i) << 24) >> 24;
+}
+
+uint loadU16(ByteAddressBuffer b, uint i) {
+    return (b.Load((i * 2u) & ~3u) >> ((i & 1u) * 16u)) & 0xFFFFu;
+}
+
+int loadS16(ByteAddressBuffer b, uint i) {
+    return int(loadU16(b, i) << 16) >> 16;
+}
+
+uint loadU32(ByteAddressBuffer b, uint i) {
+    return b.Load(i * 4u);
+}
+
+float loadF32(ByteAddressBuffer b, uint i) {
+    return asfloat(b.Load(i * 4u));
+}
+
+// Native framebuffer element: 32b = 4 bytes, 16b = 2 bytes, 8b and 4b = 1 byte (as the old typed views).
+uint loadNative(ByteAddressBuffer b, uint i, uint siz) {
+    if (siz == 3) return loadU32(b, i);
+    if (siz == 2) return loadU16(b, i);
+    return loadU8(b, i);
+}
+
+// Neighbouring threads write the other bytes of the same 32-bit word, so sub-word stores are atomic.
+void storeNative(RWByteAddressBuffer b, uint i, uint v, uint siz) {
+    if (siz == 3) {
+        b.Store(i * 4u, v);
+        return;
+    }
+
+    const uint bits = (siz == 2) ? 16u : 8u;
+    const uint perWord = 32u / bits;
+    const uint shift = (i % perWord) * bits;
+    const uint mask = ((1u << bits) - 1u) << shift;
+    const uint address = (i / perWord) * 4u;
+    uint previous;
+    b.InterlockedAnd(address, ~mask, previous);
+    b.InterlockedOr(address, (v << shift) & mask, previous);
+}
