+    // Appends a copy of a vertex already in this frame's draw data and returns its global index.
+    uint32_t RSP::copyGlobalVertex(uint32_t globalIndex) {
+        const int workloadCursor = state->ext.workloadQueue->writeCursor;
+        Workload &workload = state->ext.workloadQueue->workloads[workloadCursor];
+        DrawData &d = workload.drawData;
+        const uint32_t newIndex = d.vertexCount();
+        for (int i = 0; i < 3; i++) d.posShorts.emplace_back(d.posShorts[globalIndex * 3 + i]);
+        for (int i = 0; i < 3; i++) d.velShorts.emplace_back(d.velShorts[globalIndex * 3 + i]);
+        for (int i = 0; i < 4; i++) d.normColBytes.emplace_back(d.normColBytes[globalIndex * 4 + i]);
+        for (int i = 0; i < 2; i++) d.tcFloats.emplace_back(d.tcFloats[globalIndex * 2 + i]);
+        d.viewProjIndices.emplace_back(d.viewProjIndices[globalIndex]);
+        d.worldIndices.emplace_back(d.worldIndices[globalIndex]);
+        d.fogIndices.emplace_back(d.fogIndices[globalIndex]);
+        d.lightIndices.emplace_back(d.lightIndices[globalIndex]);
+        d.lightCounts.emplace_back(d.lightCounts[globalIndex]);
+        d.lookAtIndices.emplace_back(d.lookAtIndices[globalIndex]);
+        d.posTransformed.emplace_back(d.posTransformed[globalIndex]);
+        d.posScreen.emplace_back(d.posScreen[globalIndex]);
+        return newIndex;
+    }
+
+    // L3DEX line (HYP: Pikachu's electricity). Drawn as a screen-space quad of the given width in
+    // N64 pixels: four copies of the two end vertices (colour, texcoords and depth kept), with their
+    // screen XY moved sideways through the same path G_MODIFYVTX uses. Lines ignore face culling.
+    void RSP::drawLine(uint32_t a, uint32_t b, float width) {
+        if ((a >= RSP_MAX_VERTICES) || (b >= RSP_MAX_VERTICES)) {
+            return;
+        }
+
+        const int workloadCursor = state->ext.workloadQueue->writeCursor;
+        Workload &workload = state->ext.workloadQueue->workloads[workloadCursor];
+        const uint32_t ga = indices[a], gb = indices[b];
+        used[a] = used[b] = true;
+        if ((workload.drawData.posTransformed[ga][3] <= 0.0f) || (workload.drawData.posTransformed[gb][3] <= 0.0f)) {
+            return; // an end behind the camera: the RSP clips these; skip rather than draw garbage
+        }
+
+        const hlslpp::float3 pa = workload.drawData.posScreen[ga];
+        const hlslpp::float3 pb = workload.drawData.posScreen[gb];
+        float dx = pb[0] - pa[0], dy = pb[1] - pa[1];
+        float len = std::sqrt(dx * dx + dy * dy);
+        if (len < 1e-4f) {
+            dx = 1.0f; dy = 0.0f; len = 1.0f;
+        }
+
+        const float nx = -dy / len * width * 0.5f, ny = dx / len * width * 0.5f;
+        const float xs[4] = { pa[0] + nx, pa[0] - nx, pb[0] + nx, pb[0] - nx };
+        const float ys[4] = { pa[1] + ny, pa[1] - ny, pb[1] + ny, pb[1] - ny };
+        uint32_t q[4];
+        for (int i = 0; i < 4; i++) {
+            q[i] = copyGlobalVertex(i < 2 ? ga : gb);
+            const int16_t sx = int16_t(std::lround(xs[i] * 4.0f));
+            const int16_t sy = int16_t(std::lround(ys[i] * 4.0f));
+            const uint32_t value = (uint32_t(uint16_t(sx)) << 16) | uint32_t(uint16_t(sy));
+            workload.drawData.modifyPosUints.emplace_back(q[i] << 1);
+            workload.drawData.modifyPosUints.emplace_back(value);
+            workload.drawData.posScreen[q[i]][0] = sx / 4.0f;
+            workload.drawData.posScreen[q[i]][1] = sy / 4.0f;
+        }
+
+        uint32_t &geometryMode = geometryModeStack[geometryModeStackSize - 1];
+        const uint32_t savedMode = geometryMode;
+        if (geometryMode & cullBothMask) {
+            geometryMode &= ~cullBothMask;
+            state->updateDrawStatusAttribute(DrawAttribute::GeometryMode);
+        }
+
+        drawIndexedTri(q[0], q[1], q[2], true);
+        drawIndexedTri(q[2], q[1], q[3], true);
+
+        if (geometryMode != savedMode) {
+            geometryMode = savedMode;
+            state->updateDrawStatusAttribute(DrawAttribute::GeometryMode);
+        }
+    }
