diff --git a/src/render/rt64_projection_processor.cpp b/src/render/rt64_projection_processor.cpp
index 10a01cd..8fe1f91 100644
--- a/src/render/rt64_projection_processor.cpp
+++ b/src/render/rt64_projection_processor.cpp
@@ -8,6 +8,133 @@
 #include "hle/rt64_workload_queue.h"
 
 namespace RT64 {
+    // VR: the headset eye rides on the game's camera, and its own frustum replaces the game's projection.
+    // The game's projection only supplies near/far (and its w scale, which N64 games often use).
+    static void applyVREye(const VREye &eye, interop::float4x4 &viewMatrix, interop::float4x4 &projMatrix) {
+        interop::float4x4 eyeFromCamera;
+        for (int r = 0; r < 4; r++) {
+            for (int c = 0; c < 4; c++) {
+                eyeFromCamera[r][c] = eye.eyeFromCamera[r * 4 + c];
+            }
+        }
+
+        viewMatrix = hlslpp::mul(viewMatrix, eyeFromCamera);
+
+        float s = -projMatrix[2][3];
+        if (fabsf(s) < 1e-6f) {
+            s = 1.0f;
+        }
+
+        const float a = projMatrix[2][2] / s;
+        const float b = projMatrix[3][2] / s;
+        float n = (fabsf(a - 1.0f) > 1e-6f) ? (b / (a - 1.0f)) : 1.0f;
+        float f = (fabsf(a + 1.0f) > 1e-6f) ? (b / (a + 1.0f)) : 10000.0f;
+        if (!(n > 0.0f) || !(f > n)) {
+            n = 10.0f;
+            f = 10000.0f;
+        }
+
+        const float l = eye.tanLeft, r = eye.tanRight, u = eye.tanUp, d = eye.tanDown;
+        interop::float4x4 m;
+        for (int i = 0; i < 4; i++) {
+            for (int j = 0; j < 4; j++) {
+                m[i][j] = 0.0f;
+            }
+        }
+
+        m[0][0] = 2.0f / (r - l) * s;
+        m[1][1] = 2.0f / (u - d) * s;
+        m[2][0] = (r + l) / (r - l) * s;
+        m[2][1] = (u + d) / (u - d) * s;
+        m[2][2] = -(f + n) / (f - n) * s;
+        m[2][3] = -s;
+        m[3][2] = -2.0f * f * n / (f - n) * s;
+        projMatrix = m;
+    }
+
+    // VR: N64 games often put the camera (lookAt) into the projection matrix, so RT64's view/projection split can't be
+    // trusted. Recover the real camera from the game's combined matrix M = V * P (row vectors, P = guPerspective-style:
+    // x' = sx x, y' = sy y, z' = a z + b, w' = -z, everything times a scale s):
+    //   column 3 = -s V[:,2]   column 0 = s sx V[:,0]   column 1 = s sy V[:,1]   column 2 = s (a V[:,2] + b e3)
+    // Then rebuild: view = V * eyeFromCamera, proj = the eye's frustum with the game's near/far (times s).
+    static bool applyVREyeCombined(const VREye &eye, const interop::float4x4 &combined, interop::float4x4 &viewMatrix, interop::float4x4 &projMatrix) {
+        float c[4][4];      // c[column][row]
+        for (int i = 0; i < 4; i++) {
+            for (int j = 0; j < 4; j++) {
+                c[j][i] = combined[i][j];
+            }
+        }
+
+        const float s = sqrtf(c[3][0] * c[3][0] + c[3][1] * c[3][1] + c[3][2] * c[3][2]);
+        if (s < 1e-6f) {
+            return false;
+        }
+
+        for (int j = 0; j < 4; j++) {
+            for (int i = 0; i < 4; i++) {
+                c[j][i] /= s;
+            }
+        }
+
+        const float sx = sqrtf(c[0][0] * c[0][0] + c[0][1] * c[0][1] + c[0][2] * c[0][2]);
+        const float sy = sqrtf(c[1][0] * c[1][0] + c[1][1] * c[1][1] + c[1][2] * c[1][2]);
+        if ((sx < 1e-6f) || (sy < 1e-6f)) {
+            return false;
+        }
+
