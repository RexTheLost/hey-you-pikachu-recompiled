diff --git a/src/hle/rt64_vr.h b/src/hle/rt64_vr.h
new file mode 100644
index 0000000..d8cac13
--- /dev/null
+++ b/src/hle/rt64_vr.h
@@ -0,0 +1,79 @@
+//
+// RT64 VR (Hey You, Pikachu VR port)
+//
+// Stereo rendering: every display frame is drawn once per eye. The game's own camera stays the "body";
+// each eye adds the headset pose on top (view = gameView * eyeFromCamera) and uses the headset's own
+// field of view (projection rebuilt from the eye's tangents with the game's near/far planes).
+//
+// The game side implements VRInterface (OpenXR) and registers it with SetVRInterface() before RT64
+// starts rendering. With no interface registered nothing changes.
+//
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace RT64 {
+    struct RenderDevice;
+    struct RenderTexture;
+    struct RenderFramebuffer;
+    struct RenderCommandList;
+
+    struct VREye {
+        // Row-vector 4x4 (v' = v * M), applied after the game's view matrix: camera space -> eye space.
+        // Translation is already in game units.
+        float eyeFromCamera[16];
+        // Tangents of the eye's field of view: left (negative), right, up, down (negative).
+        float tanLeft, tanRight, tanUp, tanDown;
+    };
+
+    struct VRFrameViews {
+        VREye eyes[2];
+        uint64_t token = 0;      // identifies the head pose these views came from (handed back on present)
+    };
+
+    struct VRTarget {
+        RenderTexture *texture = nullptr;
+        RenderFramebuffer *framebuffer = nullptr;
+        uint32_t width = 0;
+        uint32_t height = 0;
+    };
+
+    struct VRInterface {
+        virtual ~VRInterface() = default;
+
+        // True while the headset shows our frames: render stereo.
+        virtual bool active() = 0;
+
+        // Workload thread, once per display frame: the newest per-eye views.
+        virtual void latestViews(VRFrameViews &out) = 0;
+
+        // Present thread: start an XR frame and acquire one image per eye for the frame rendered with 'token'.
+        // Returns false when this frame should not be drawn (session not visible yet, etc.).
+        virtual bool beginPresent(RenderDevice *device, uint64_t token, VRTarget out[2]) = 0;
+
+        // Present thread, after the GPU finished drawing into the targets: release them and submit the frame.
+        virtual void endPresent(bool drawn) = 0;
+
+        // Application::end(), after the render threads stopped and before the device is destroyed:
+        // free everything that uses the device (eye images, the XR session).
+        virtual void releaseDeviceResources() = 0;
+
+        // Debug: a path prefix when the next presented frame's eye images should be saved (<prefix>_L.ppm / _R.ppm).
+        virtual bool takeDumpRequest(std::string &prefix) { return false; }
+
+        // Present thread, after both eyes: record extra GPU work (e.g. uploading the floating panel's pixels).
+        // Return true if anything was recorded; RT64 then submits and waits for it before endPresent().
+        virtual bool recordOverlay(RenderDevice *device, RenderCommandList *commandList) { return false; }
+    };
+
+    inline VRInterface *&VRInterfaceSlot() {
+        static VRInterface *vr = nullptr;
+        return vr;
+    }
+
+    inline void SetVRInterface(VRInterface *vr) { VRInterfaceSlot() = vr; }
+    inline VRInterface *GetVRInterface() { return VRInterfaceSlot(); }
+    inline bool VRActive() { VRInterface *vr = VRInterfaceSlot(); return (vr != nullptr) && vr->active(); }
+};
