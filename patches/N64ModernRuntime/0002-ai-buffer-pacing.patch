 extern std::atomic_bool exited;
+
+// AI event pacing by buffer consumption (see ultramodern::set_ai_buffer_pacing).
+static std::atomic_bool ai_buffer_pacing = false;
+static std::atomic_uint32_t ai_low_water_ms = 50;
+static std::atomic_bool ai_event_outstanding = false;
+static std::thread ai_thread;
+
+void ultramodern::set_ai_buffer_pacing(bool enabled, uint32_t low_water_ms) {
+    ai_low_water_ms = low_water_ms;
+    ai_buffer_pacing = enabled;
+}
+
+void ultramodern::notify_ai_buffer_queued() {
+    ai_event_outstanding = false;
+}
+
+void ai_thread_func() {
+    ultramodern::set_native_thread_name("AI Thread");
+    using namespace std::chrono_literals;
+    while (!exited) {
+        ultramodern::sleep_milliseconds(1);
+        if (!ai_buffer_pacing || !ultramodern::is_game_started() || ai_event_outstanding) {
+            continue;
+        }
+        uint32_t frames_left = ultramodern::get_remaining_audio_bytes() / (2 * sizeof(int16_t));
+        uint32_t low_water_frames = ultramodern::get_audio_frequency() * ai_low_water_ms / 1000;
+        if (frames_left >= low_water_frames) {
+            continue;
+        }
+        uint8_t* rdram = events_context.rdram;
+        std::lock_guard lock{ events_context.message_mutex };
+        if (events_context.ai.mq != NULLPTR) {
+            ai_event_outstanding = true;
+            if (osSendMesg(PASS_RDRAM events_context.ai.mq, events_context.ai.msg, OS_MESG_NOBLOCK) == -1) {
+                ai_event_outstanding = false; // queue full; retry next tick
+            }
+        }
+    }
+}
